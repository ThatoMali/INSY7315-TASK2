# Copy to .env (optional — everything has a working default for local use)
PORT=3000
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES=8h

# Where the SQLite file and uploaded photos live (defaults: ./data and ./uploads).
# On a host with a persistent disk, point these at the disk mount, e.g. /var/data/frims
# DATA_DIR=./data
# UPLOAD_DIR=./uploads

# Only needed if the front-end is served from a different origin than the API.
# CORS_ORIGIN=https://your-frontend.example.com

# Public self-registration (creates field rangers with no section). Off by default.
# ALLOW_REGISTRATION=false
